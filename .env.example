# --- LLM provider (OpenRouter free models via LiteLLM) ---
OPENROUTER_API_KEY=sk-or-v1-...
LITELLM_MASTER_KEY=sk-litellm-demo
# LiteLLM Admin UI login (http://localhost:4000/ui)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin
LITELLM_SALT_KEY=sk-salt-demo
# OpenRouter model routed by LiteLLM alias "chat-model" (free models rotate; check https://openrouter.ai/models?q=free)
CHAT_MODEL=openrouter/google/gemma-4-31b-it:free

# --- App behaviour ---
# true = no LLM calls, deterministic mock answers (demo works offline)
AI_MOCK=false
# true = bind the LangChain4j @Tool decisionDetail to the argue nodes (works with Gemma, loops with reasoning models)
AI_TOOLS_ENABLED=false
# snapshot = load bundled data/snapshot instead of calling rozhodnuti.justice.cz
INGEST_SOURCE=api
INGEST_DEFAULT_LIMIT=300
